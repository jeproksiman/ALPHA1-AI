ALPHA_RUNTIME_MODE=auto
# Local speech uses cached models; downloads require explicit opt-in.
ALPHA_OFFLINE_STT_PROVIDER=faster-whisper
ALPHA_WHISPER_MODEL=small
ALPHA_WHISPER_DEVICE=auto
ALPHA_WHISPER_COMPUTE_TYPE=auto
ALPHA_ALLOW_MODEL_DOWNLOAD=false
# Vosk remains an optional fallback.
ALPHA_OFFLINE_STT_MODEL_PATH=
ALPHA_OFFLINE_TTS_PROVIDER=auto
ALPHA_PIPER_VOICE_PATH=
ALPHA_TTS_ENABLED=true
ALPHA_OFFLINE_WARMUP=true
# Opt-in threshold barge-in; test with your headphones/room first.
ALPHA_OFFLINE_BARGE_IN=false
ALPHA_OFFLINE_BRAIN_ENABLED=true
ALPHA_OLLAMA_ENABLED=true
ALPHA_OLLAMA_URL=http://127.0.0.1:11434
ALPHA_OLLAMA_MODEL=gemma4:e4b
ALPHA_OLLAMA_FAST_MODEL=qwen3.5:0.8b
ALPHA_SEMANTIC_MEMORY=true
ALPHA_EMBEDDING_PROVIDER=ollama
ALPHA_EMBEDDING_MODEL=nomic-embed-text:latest
ALPHA_LOCAL_CONFIDENCE_THRESHOLD=0.80
ALPHA_AUTO_LEARN_OLLAMA=false
